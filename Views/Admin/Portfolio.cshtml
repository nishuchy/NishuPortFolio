
@{
    ViewData["Title"] = "Portfolio";

}

@model List<NishuPortFolio.Models.PortFolioAdd>



<h2>Portfolio</h2>
<div class="row">
    <div class="col-md-12">
        <div class="card">
            <div class="header">
                <h4 class="title">Portfolio List</h4>


                <a asp-controller="Admin" asp-action="PortfolioAdd" class="btn btn-info btn-fill pull-left">Add New</a>
            </div>
            <div class="content table-responsive table-full-width">
                <table class="table table-hover table-striped">
                    <thead>
                    <th>SL</th>
                    <th>Title</th>
                    <th></th>
                    <th></th>
                    </thead>
                    <tbody>

                   
                        @if (ViewBag.portfoliodata != null)
                        {
                            int serialNo = 1;
                            foreach (var item in ViewBag.portfoliodata)
                            {
                               
                                <tr>

                                    <td>@serialNo</td>
                                    <td>@item.portfoliotitle</td>
                                    <td><a asp-action="UpdatePortfolio" asp-route-sid="@item.portfolioid">Update</a></td>
                                    <td>
                                        <form asp-action="DeletePortfolio" method="post" asp-route-id="@item.portfolioid" onsubmit="return confirmDelete()">
                                            <button><i class="pe-7s-trash"></i></button>
                                        </form>
                                   
                                    </td>
                                </tr>
                                serialNo++;
                            }
                        }
                    </tbody>
                </table>

            </div>
        </div>
    </div>


   
</div>

