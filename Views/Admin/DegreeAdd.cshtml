@model NishuPortFolio.Models.DegreeAdd
@{
    ViewData["Title"] = "DegreeAdd";
   
}

<div class="row">
    <div class="col-md-12">
        <div class="card">
            <div style="margin:22px;">

                <div class="row">
                    <div class="col-md-12">
                        <h2>Degree Add</h2>
                    </div>
                    <div class="col-md-12">
                        <a asp-action="Degree" style="padding:20px 30px">Back to List</a>
                    </div>
                </div>

                <hr />
            </div>

            <form asp-area="Admin" asp-controller="Admin" asp-action="DegreeSave" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>



                <div class="row">
                    <div class="col-md-12">
                        <div class="form-group" style="margin:22px;">
                            @if (ViewBag.Msg != null)
                            {
                                <div class="alert alert-success" role="alert">
                                    @ViewBag.Msg
                                </div>
                            }
                        </div>
                    </div>

                    <div class="col-md-12">
                        <div class="form-group" style="margin:22px;">
                            <label asp-for="DegreeTitle">Title</label>
                            <input asp-for="DegreeTitle" class="form-control" />
                            <span asp-validation-for="DegreeTitle" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="col-md-12">
                        <div class="form-group" style="margin:22px;">
                            <label asp-for="DegreeInstitute">Description</label>
                                         
                            <input asp-for="DegreeInstitute" class="form-control" />
                            <span asp-validation-for="DegreeInstitute" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="col-md-12">
                        <div class="form-group" style="margin:22px;">
                            <input type="submit" value="Create" class="btn btn-info btn-fill" />

                        </div>
                    </div>
                </div>
            </form>


        </div>


    </div>




</div>
